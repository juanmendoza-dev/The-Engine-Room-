#!/bin/sh
# AGENTS.md rule: commits must show only the human author, no AI co-author trailers.
if grep -qiE 'co-authored-by:.*(claude|anthropic)|generated with.*claude' "$1"; then
  echo "ERROR: commit message contains AI co-author attribution." >&2
  echo "AGENTS.md rule: remove the Co-Authored-By/Generated-with trailer and commit again." >&2
  exit 1
fi
