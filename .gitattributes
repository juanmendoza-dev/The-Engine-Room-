.githooks/* text eol=lf
.claude/hooks/* text eol=lf

# Engine assets. Git on Windows will happily decide a binary is text and
# rewrite its line endings, which corrupts it silently.
*.wasm binary
*.onnx binary
*.nnue binary

# Same reasoning for the README gallery screenshots. Git's own detection gets
# PNG right, so this is belt-and-braces rather than a fix for something seen.
*.png binary
